# ─── Databricks Workspace ────────────────────────────────────────────
DATABRICKS_HOST=https://adb-1234567890.azuredatabricks.net
DATABRICKS_TOKEN=dapi_your_token_here

# ─── Model Serving ───────────────────────────────────────────────────
MODEL_SERVING_ENDPOINT=databricks-meta-llama-3-1-70b-instruct

# ─── Lakebase Connection ─────────────────────────────────────────────
LAKEBASE_HOST=your-lakebase-host.azuredatabricks.net
LAKEBASE_PORT=5432
LAKEBASE_DATABASE=lakebase
LAKEBASE_USER=sp_accelerator
LAKEBASE_PASSWORD=your_password_here

# ─── Application ─────────────────────────────────────────────────────
APP_NAME=lakebase-accelerator
APP_VERSION=1.0.0
CATALOG_NAME=zeb_prod

# ─── Pipeline ────────────────────────────────────────────────────────
PIPELINE_TIMEOUT_SECONDS=300
DEPLOYMENT_POLL_INTERVAL_SECONDS=10
DEPLOYMENT_TIMEOUT_SECONDS=300

# ─── LLM ─────────────────────────────────────────────────────────────
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ─── Connection Pool ─────────────────────────────────────────────────
DB_POOL_MIN_CONNECTIONS=2
DB_POOL_MAX_CONNECTIONS=10
