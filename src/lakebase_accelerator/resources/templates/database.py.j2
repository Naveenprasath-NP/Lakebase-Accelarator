"""Database connection management with OAuth token support for Lakebase.

Lakebase uses OAuth tokens (60-minute lifetime) for authentication.
Supports two modes:
1. OAuth via Databricks REST API (when DATABRICKS_HOST + DATABRICKS_CLIENT_ID + DATABRICKS_CLIENT_SECRET are set)
2. Static password (when POSTGRES_PASSWORD is set directly)
"""

import os
import logging
from contextlib import contextmanager

import httpx
import psycopg2
from psycopg2 import pool, sql
from psycopg2.extras import RealDictCursor

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Configuration from environment
POSTGRES_HOST = os.getenv("POSTGRES_HOST", "localhost")
POSTGRES_PORT = os.getenv("POSTGRES_PORT", "5432")
POSTGRES_USER = os.getenv("POSTGRES_USER", "postgres")
POSTGRES_DB = os.getenv("POSTGRES_DB", "databricks_postgres")
POSTGRES_PASSWORD = os.getenv("POSTGRES_PASSWORD", "")
LAKEBASE_SCHEMA = os.getenv("LAKEBASE_SCHEMA", "public")

# OAuth config
DATABRICKS_HOST = os.getenv("DATABRICKS_HOST", "")
DATABRICKS_CLIENT_ID = os.getenv("DATABRICKS_CLIENT_ID", "")
DATABRICKS_CLIENT_SECRET = os.getenv("DATABRICKS_CLIENT_SECRET", "")
LAKEBASE_ENDPOINT_NAME = os.getenv("LAKEBASE_ENDPOINT_NAME", "")

connection_pool = None


def _get_oauth_token() -> str:
    """Generate a Lakebase OAuth token via Databricks REST API."""
    # Step 1: Get workspace OAuth token
    token_url = f"{DATABRICKS_HOST.rstrip('/')}/oidc/v1/token"
    response = httpx.post(
        token_url,
        data={"grant_type": "client_credentials", "scope": "all-apis"},
        auth=(DATABRICKS_CLIENT_ID, DATABRICKS_CLIENT_SECRET),
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        timeout=30.0,
    )
    if response.status_code != 200:
        raise RuntimeError(f"Failed to get workspace token: {response.status_code}")
    workspace_token = response.json()["access_token"]

    # Step 2: Exchange for database credential
    cred_url = f"{DATABRICKS_HOST.rstrip('/')}/api/2.0/postgres/credentials"
    cred_response = httpx.post(
        cred_url,
        json={"endpoint": LAKEBASE_ENDPOINT_NAME},
        headers={"Authorization": f"Bearer {workspace_token}", "Content-Type": "application/json"},
        timeout=30.0,
    )
    if cred_response.status_code != 200:
        raise RuntimeError(f"Failed to get database credential: {cred_response.status_code}")
    return cred_response.json()["token"]


def _get_password() -> str:
    """Get database password — OAuth token or static password."""
    if POSTGRES_PASSWORD:
        return POSTGRES_PASSWORD
    if DATABRICKS_HOST and DATABRICKS_CLIENT_ID and DATABRICKS_CLIENT_SECRET and LAKEBASE_ENDPOINT_NAME:
        return _get_oauth_token()
    raise RuntimeError("No authentication configured. Set POSTGRES_PASSWORD or OAuth env vars.")


def init_db(minconn=1, maxconn=10):
    """Initialize the connection pool."""
    global connection_pool
    password = _get_password()
    connection_pool = psycopg2.pool.SimpleConnectionPool(
        minconn,
        maxconn,
        host=POSTGRES_HOST,
        port=POSTGRES_PORT,
        user=POSTGRES_USER,
        password=password,
        database=POSTGRES_DB,
        sslmode="require",
        options=f"-c search_path={LAKEBASE_SCHEMA}",
    )
    logger.info("Database connection pool created successfully")


def close_db():
    """Close all connections in the pool."""
    global connection_pool
    if connection_pool:
        connection_pool.closeall()
        logger.info("Database connection pool closed")


def get_connection():
    """Get a connection from the pool, refreshing token if stale."""
    global connection_pool
    if not connection_pool:
        raise RuntimeError("Connection pool not initialized. Call init_db() first.")
    conn = connection_pool.getconn()
    try:
        with conn.cursor() as cur:
            cur.execute("SELECT 1")
        conn.commit()
    except Exception:
        logger.warning("Stale connection detected, refreshing pool")
        try:
            connection_pool.putconn(conn, close=True)
        except Exception:
            pass
        _refresh_pool()
        conn = connection_pool.getconn()
    return conn


def return_connection(conn):
    """Return a connection to the pool."""
    if connection_pool:
        connection_pool.putconn(conn)


@contextmanager
def get_db_cursor(commit=False):
    """Context manager for database cursor with auto commit/rollback."""
    conn = get_connection()
    try:
        cursor = conn.cursor(cursor_factory=RealDictCursor)
        yield cursor
        if commit:
            conn.commit()
    except Exception as e:
        conn.rollback()
        raise
    finally:
        cursor.close()
        return_connection(conn)


def _refresh_pool():
    """Refresh the pool with a new OAuth token."""
    global connection_pool
    if connection_pool:
        try:
            connection_pool.closeall()
        except Exception:
            pass
    init_db()
