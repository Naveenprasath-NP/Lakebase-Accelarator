@router.get("", response_model=list[{{ entity_name | capitalize }}Response])
def get_{{ entity_plural }}():
    """Get all {{ entity_plural }} ordered by creation date."""
    with get_db_cursor() as cur:
        cur.execute(
            sql.SQL(
                "SELECT {{ column_names }} FROM {table} ORDER BY created_at DESC"
            ).format(table=sql.Identifier("{{ entity_name }}"))
        )
        rows = cur.fetchall()
        return [dict(row) for row in rows]


@router.get("/{item_id}", response_model={{ entity_name | capitalize }}Response)
def get_{{ entity_name }}(item_id: str):
    """Get a single {{ entity_name }} by ID."""
    with get_db_cursor() as cur:
        cur.execute(
            sql.SQL(
                "SELECT {{ column_names }} FROM {table} WHERE id = %s"
            ).format(table=sql.Identifier("{{ entity_name }}")),
            (item_id,),
        )
        row = cur.fetchone()
        if not row:
            raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="{{ entity_name | capitalize }} not found")
        return dict(row)


@router.post("", response_model={{ entity_name | capitalize }}Response, status_code=status.HTTP_201_CREATED)
def create_{{ entity_name }}(item: {{ entity_name | capitalize }}Create):
    """Create a new {{ entity_name }}."""
    item_id = str(uuid.uuid4())
    now = datetime.utcnow()

    with get_db_cursor(commit=True) as cur:
        cur.execute(
            sql.SQL(
                "INSERT INTO {table} (id, {{ insert_columns }}, created_at, updated_at) "
                "VALUES (%s, {{ insert_placeholders }}, %s, %s) "
                "RETURNING {{ column_names }}"
            ).format(table=sql.Identifier("{{ entity_name }}")),
            (item_id, {{ insert_values }}, now, now),
        )
        created = cur.fetchone()
        return dict(created)


@router.put("/{item_id}", response_model={{ entity_name | capitalize }}Response)
def update_{{ entity_name }}(item_id: str, item: {{ entity_name | capitalize }}Update):
    """Update an existing {{ entity_name }}."""
    with get_db_cursor(commit=True) as cur:
        # Check exists
        cur.execute(
            sql.SQL("SELECT id FROM {table} WHERE id = %s").format(table=sql.Identifier("{{ entity_name }}")),
            (item_id,),
        )
        if not cur.fetchone():
            raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="{{ entity_name | capitalize }} not found")

        # Build dynamic update
        update_fields = []
        update_values = []
{% for col in columns if col.name not in ['id', 'created_at', 'updated_at'] %}
        if item.{{ col.name }} is not None:
            update_fields.append(sql.SQL("{field} = %s").format(field=sql.Identifier("{{ col.name }}")))
            update_values.append(item.{{ col.name }})
{% endfor %}

        if not update_fields:
            raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail="No fields to update")

        update_fields.append(sql.SQL("{field} = %s").format(field=sql.Identifier("updated_at")))
        update_values.append(datetime.utcnow())
        update_values.append(item_id)

        cur.execute(
            sql.SQL(
                "UPDATE {table} SET {fields} WHERE id = %s RETURNING {{ column_names }}"
            ).format(
                table=sql.Identifier("{{ entity_name }}"),
                fields=sql.SQL(", ").join(update_fields),
            ),
            update_values,
        )
        updated = cur.fetchone()
        return dict(updated)


@router.delete("/{item_id}", status_code=status.HTTP_204_NO_CONTENT)
def delete_{{ entity_name }}(item_id: str):
    """Delete a {{ entity_name }} by ID."""
    with get_db_cursor(commit=True) as cur:
        cur.execute(
            sql.SQL("DELETE FROM {table} WHERE id = %s RETURNING id").format(table=sql.Identifier("{{ entity_name }}")),
            (item_id,),
        )
        if not cur.fetchone():
            raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="{{ entity_name | capitalize }} not found")
