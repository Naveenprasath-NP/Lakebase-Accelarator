@router.get("/stats")
def get_{{ entity.plural }}_stats():
    """Get statistics for dashboard."""
    with get_db_cursor() as cur:
        # Total count
        cur.execute(
            sql.SQL("SELECT COUNT(*) as total FROM {}").format(sql.Identifier("{{ entity.name }}"))
        )
        total = cur.fetchone()["total"]

        # Created today
        cur.execute(
            sql.SQL("SELECT COUNT(*) as count FROM {} WHERE created_at >= CURRENT_DATE").format(
                sql.Identifier("{{ entity.name }}")
            )
        )
        today_count = cur.fetchone()["count"]

        # Created this week
        cur.execute(
            sql.SQL("SELECT COUNT(*) as count FROM {} WHERE created_at >= CURRENT_DATE - INTERVAL '7 days'").format(
                sql.Identifier("{{ entity.name }}")
            )
        )
        week_count = cur.fetchone()["count"]

{% if entity.has_status %}
        # Count by status
        cur.execute(
            sql.SQL("SELECT {{ entity.status_column }}, COUNT(*) as count FROM {} GROUP BY {{ entity.status_column }}").format(
                sql.Identifier("{{ entity.name }}")
            )
        )
        by_status = {}
        for row in cur.fetchall():
            by_status[row["{{ entity.status_column }}"] or "unknown"] = row["count"]
{% else %}
        by_status = {}
{% endif %}

        return {
            "total": total,
            "today_count": today_count,
            "week_count": week_count,
            "by_status": by_status,
        }


